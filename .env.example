# Configuration for the SageMaker training/eval/deploy scripts in training/.
#
# Copy this to .env and fill in real values, or run ./make-env.sh <source.env>
# to copy one kept elsewhere. .env is git-ignored; real values are never
# committed to this repo.
#
# Real process environment variables override .env, so you can also just export
# these in your shell.

# AWS account that owns the SageMaker execution role and buckets. Required.
AWS_ACCOUNT_ID=000000000000

# Name of the SageMaker execution role (not the full ARN; the ARN is built from
# AWS_ACCOUNT_ID + this). The role's policy must allow the job-name prefix below.
# Required.
SAGEMAKER_ROLE_NAME=your-sagemaker-execution-role

# Prefix for job names and the S3 working prefix under the sagemaker-<region>-<account>
# bucket. Must match what the role's policy allows. Required.
SAGEMAKER_JOB_PREFIX=your-job-prefix

# Default region for the deploy scripts (training/eval jobs accept --region to
# override). Namespaced so it does not collide with a global AWS_REGION. Optional.
SAGEMAKER_REGION=us-east-2

# Default training/eval instance type. Optional.
SAGEMAKER_INSTANCE=ml.g6e.12xlarge

# Tags put on every job, model and endpoint. Optional; owner is omitted if unset.
SAGEMAKER_TAG_PROJECT=fine-tuning
SAGEMAKER_TAG_OWNER=
